# Copy this file to .env and fill in your key.
# Get an Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Fernet key used to encrypt stored DB connection credentials.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=ENCRYPTION_KEY=VFuesxN984X0LIaIgWKYx5CmYTKioMSghMPZzW0GrMI=

# App's own metadata database (users, connections, query history)
APP_DATABASE_URL=sqlite:///./querymind_app.db
